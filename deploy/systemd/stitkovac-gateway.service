[Unit]
Description=Stitkovac local print gateway
After=NetworkManager.service
RequiresMountsFor=/data
ConditionPathIsMountPoint=/data
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=stitkovac-gateway
Group=stitkovac-gateway
WorkingDirectory=/data/gateway
EnvironmentFile=/etc/stitkovac-gateway/gateway.env
ExecStartPre=/usr/lib/stitkovac-gateway/check-storage
ExecStart=/usr/lib/stitkovac-gateway/gateway serve --data-dir /data/gateway $GATEWAY_ARGS
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/data/gateway
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
LockPersonality=true
RestrictSUIDSGID=true
MemoryMax=384M
TasksMax=128

[Install]
WantedBy=multi-user.target
